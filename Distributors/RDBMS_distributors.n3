SELECT DISTINCT
(SHA1(STR(STR(?document) + STR(?organization))) as ?publisher_id)
(STR(?document) as ?document_id)
(STR(?organization) as ?organization_id)
WHERE {
  {
   ?document a bibo:Journal .
  }
  UNION
  {
   ?document a bibo:Document .
  }
   ?document vivo:publisher ?organization .
} ORDER BY ?publisher_id
""" ;
   :resultFormat "CSV" .
:RDBMS_OrganizationEmail a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_OrganizationEmail" ;
   :query """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX vitro: <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/> 
SELECT DISTINCT
(SHA1(STR(STR(?emailUri) + STR(?emailLit))) as ?email_id)
(?emailLit as ?email)
(STR(?organization) as ?organization_id)
WHERE {
    ?organization a foaf:Organization .
    ?organization obo:ARG_2000028/vcard:hasEmail ?emailUri .
    ?emailUri vcard:email ?emailLit .
}
""" ;
   :resultFormat "CSV" .
:RDBMS_GrantAssigner a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_GrantAssigner" ;
   :query """
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX bib: <http://zeitkunst.org/bibtex/0.1/bibtex.owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/> 
SELECT DISTINCT
(SHA1(STR(STR(?grant) + STR(?org))) as ?grant_assigner_id)
(STR(?grant) as ?grant_id)
(STR(?org) as ?organization_id)
WHERE {
  ?grant a vivo:Grant .
  ?grant vivo:assignedBy ?org .
  ?org a foaf:Organization .
} ORDER BY ?grant
""" ;
   :resultFormat "CSV" .
:RDBMS_ResearchArea a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_ResearchArea" ;
   :query """
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX bib: <http://zeitkunst.org/bibtex/0.1/bibtex.owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vitro: <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
SELECT DISTINCT
(STR(?researchArea) as ?research_area_id)
(STR(?label) as ?research_area_name)

WHERE
{
   ?s vivo:hasSubjectArea|vivo:hasResearchArea ?researchArea .
   ?researchArea rdfs:label ?label .
}
""" ;
   :resultFormat "CSV" .
:RDBMS_GrantHierarchy a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_GrantHierarchy" ;
   :query """
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX bib: <http://zeitkunst.org/bibtex/0.1/bibtex.owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/> 
SELECT DISTINCT
(SHA1(STR(STR(?grant) + STR(?part))) as ?grant_hierarchy_id)
(STR(?grant) as ?grant_id)
(STR(?part) as ?subgrant_id)
WHERE {
  ?part a vivo:Grant .
  ?part obo:BFO_0000050 ?grant .
} ORDER BY ?grant
""" ;
   :resultFormat "CSV" .
:RDBMS_ISBN a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_ISBN" ;
   :query """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX vitro: <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX bibo: <http://purl.org/ontology/bibo/>

SELECT DISTINCT
(SHA1(STR(STR(?document) + STR(?isbnLt))) as ?isbn_id)
(?isbnLt as ?isbn)
(STR(?document) as ?document_id)
WHERE {
    ?document bibo:isbn10|bibo:isbn13 ?isbnLt .
  ?document a bibo:Document .
}
""" ;
   :resultFormat "CSV" .
:RDBMS_OrganizationWebsite a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_OrganizationWebsite" ;
   :query """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX vitro: <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/> 
SELECT DISTINCT
(SHA1(STR(STR(?urlUri) + STR(?URL))) as ?url_id)
(?URL as ?url)
(STR(?organization) as ?organization_id)
WHERE {
    ?organization a foaf:Organization .
    ?organization obo:ARG_2000028/vcard:hasURL ?urlUri .
  ?urlUri vcard:url ?URL .
}
""" ;
   :resultFormat "CSV" .
:RDBMS_Person a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_Person" ;
   :query """
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
SELECT DISTINCT
(STR(?person) as ?person_id)
?firstname
?other_name
?lastname
WHERE {
  ?person a foaf:Person .
  ?person obo:ARG_2000028/vcard:hasName/vcard:familyName ?lastname .
  ?person obo:ARG_2000028/vcard:hasName/vcard:givenName ?firstname .
  OPTIONAL {
    ?person obo:ARG_2000028/vcard:hasName/vivo:middleName ?other_name .
  } 
} ORDER BY ?person
""" ;
   :resultFormat "CSV" .
:RDBMS_GrantDateTimeInterval a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_GrantDateTimeInterval" ;
   :query """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX event: <http://purl.org/NET/c4dm/event.owl#>
PREFIX ev: <http://www.w3.org/2001/xml-events/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
SELECT DISTINCT
(STR(?dti) as ?date_time_interval_id)
(STR(?grant) as ?grant_id)
(STR(?cleanStartDateValue) as ?start_date)
(STR(?cleanEndDateValue) as ?end_date)
WHERE {
  ?grant a vivo:Grant .
  ?grant vivo:dateTimeInterval ?dti .
   OPTIONAL {
    ?dti vivo:start ?start .
    ?start vivo:dateTime ?startDtv .
    BIND (
      COALESCE(
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearPrecision 
          }, SUBSTR(str(?startDtv), 1, 4), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthPrecision 
          }, SUBSTR(str(?startDtv), 1, 7), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthDayPrecision 
          }, SUBSTR(str(?startDtv), 1, 10), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthDayHourMinutePrecision 
          }, SUBSTR(str(?startDtv), 1, 16), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthDayHourPrecision 
          }, SUBSTR(str(?startDtv), 1, 13), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthDayTimePrecision 
          }, SUBSTR(str(?startDtv), 1, 19), 1/0)
      ) AS ?cleanStartDateValue
    )
  }
  
  OPTIONAL {
    ?dti vivo:end ?end .
    ?end vivo:dateTime ?endDtv .
    BIND (
      COALESCE(
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearPrecision 
          }, SUBSTR(str(?endDtv), 1, 4), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthPrecision 
          }, SUBSTR(str(?endDtv), 1, 7), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthDayPrecision 
          }, SUBSTR(str(?endDtv), 1, 10), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthDayHourPrecision 
          }, SUBSTR(str(?endDtv), 1, 13), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthDayHourMinutePrecision 
          }, SUBSTR(str(?endDtv), 1, 16), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthDayTimePrecision 
          }, SUBSTR(str(?endDtv), 1, 19), 1/0)
      ) AS ?cleanEndDateValue
    )
  }
}
ORDER BY ?dti
""" ;
   :resultFormat "CSV" .
:RDBMS_PositionDateTimeInterval a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_PositionDateTimeInterval" ;
   :query """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX event: <http://purl.org/NET/c4dm/event.owl#>
PREFIX ev: <http://www.w3.org/2001/xml-events/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
SELECT DISTINCT
(STR(?dti) as ?date_time_interval_id)
(STR(?position) as ?position_id)
(STR(?cleanStartDateValue) as ?start_date)
(STR(?cleanEndDateValue) as ?end_date)
WHERE {
  ?person obo:RO_0000053 ?position .
  ?position vivo:dateTimeInterval ?dti .
  OPTIONAL {
    ?dti vivo:start ?start .
    ?start vivo:dateTime ?startDtv .
    BIND (
      COALESCE(
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearPrecision 
          }, SUBSTR(str(?startDtv), 1, 4), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthPrecision 
          }, SUBSTR(str(?startDtv), 1, 7), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthDayPrecision 
          }, SUBSTR(str(?startDtv), 1, 10), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthDayHourPrecision 
          }, SUBSTR(str(?startDtv), 1, 13), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthDayHourMinutePrecision 
          }, SUBSTR(str(?startDtv), 1, 16), 1/0),
        IF(EXISTS{
            ?start vivo:dateTimePrecision vivo:yearMonthDayTimePrecision 
          }, SUBSTR(str(?startDtv), 1, 19), 1/0)
      ) AS ?cleanStartDateValue
    )
  }
  
  OPTIONAL {
    ?dti vivo:end ?end .
    ?end vivo:dateTime ?endDtv .
    BIND (
      COALESCE(
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearPrecision 
          }, SUBSTR(str(?endDtv), 1, 4), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthPrecision 
          }, SUBSTR(str(?endDtv), 1, 7), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthDayPrecision 
          }, SUBSTR(str(?endDtv), 1, 10), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthDayHourPrecision 
          }, SUBSTR(str(?endDtv), 1, 13), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthDayHourMinutePrecision 
          }, SUBSTR(str(?endDtv), 1, 16), 1/0),
        IF(EXISTS{
            ?end vivo:dateTimePrecision vivo:yearMonthDayTimePrecision 
          }, SUBSTR(str(?endDtv), 1, 19), 1/0)
      ) AS ?cleanEndDateValue
    )
  }
}
ORDER BY ?dti
""" ;
   :resultFormat "CSV" .
:RDBMS_EventDateTimeInterval a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_EventDateTimeInterval" ;
   :query """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX event: <http://purl.org/NET/c4dm/event.owl#>
PREFIX ev: <http://www.w3.org/2001/xml-events/>
