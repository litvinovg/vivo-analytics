    BIND("RDBMS_OrganizationTelephone" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_DocumentPageStart" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_PersonEmail" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Document" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_PersonPosition" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Researcher" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Authorship" as ?name) 
  }
  UNION
  {
