:RDBMS_Publisher a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_Publisher" ;
   :query """
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX bib: <http://zeitkunst.org/bibtex/0.1/bibtex.owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
