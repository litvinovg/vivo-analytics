@prefix : <http://vitro.mannlib.cornell.edu/ns/vitro/ApplicationSetup#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vivo: <http://vivoweb.org/ontology/core#> .

:RDBMS a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS" ;
   :query """
SELECT ?name
WHERE
{
  {
    BIND("RDBMS_Geolocation" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Scopus" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_PersonAddress" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Grant" as ?name) 
  }
  UNION
