    BIND("RDBMS_PersonResearchArea" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Issue" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_OrganizationGeolocation" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_PersonWebsite" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_ISSN" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Investigatorship" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_EventResearchArea" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_DocumentPageEnd" as ?name) 
  }
  UNION
