  }
  UNION
  {
    BIND("RDBMS_OrganizationAddress" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Orcid" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_DocumentResearchArea" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_EventGeolocation" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_PersonTelephone" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_Organization" as ?name) 
  }
  UNION
  {
    BIND("RDBMS_GrantResearchArea" as ?name) 
  }
  UNION
  {
