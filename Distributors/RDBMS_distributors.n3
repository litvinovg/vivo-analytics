:RDBMS_DocumentDateTime a <java:edu.cornell.library.scholars.webapp.controller.api.distribute.DataDistributor> , <java:edu.cornell.library.scholars.webapp.controller.api.distribute.rdf.SelectFromContentDistributor> ;
   :actionName "RDBMS_DocumentDateTime" ;
   :query """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX event: <http://purl.org/NET/c4dm/event.owl#>
PREFIX ev: <http://www.w3.org/2001/xml-events/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX bibo: <http://purl.org/ontology/bibo/>

SELECT DISTINCT
(STR(?date) as ?date_time_id)
(STR(?document) as ?document_id)
(STR(?cleanDateValue) as ?date_time)
WHERE {
  { ?document a bibo:Document .}
  UNION
  { ?document a bibo:Journal .}
  ?document vivo:dateTimeValue ?date .
  ?date vivo:dateTime ?dtv .
  BIND (
    COALESCE(
      IF(EXISTS{
          ?date vivo:dateTimePrecision vivo:yearMonthPrecision 
        }, SUBSTR(str(?dtv), 1, 7), 1/0),
      IF(EXISTS{
          ?date vivo:dateTimePrecision vivo:yearPrecision 
        }, SUBSTR(str(?dtv), 1, 4), 1/0),
      IF(EXISTS{
          ?date vivo:dateTimePrecision vivo:yearMonthDayPrecision 
        }, SUBSTR(str(?dtv), 1, 10), 1/0),
      IF(EXISTS{
          ?date vivo:dateTimePrecision vivo:yearMonthDayHourPrecision 
        }, SUBSTR(str(?dtv), 1, 13), 1/0),
      IF(EXISTS{
          ?date vivo:dateTimePrecision vivo:yearMonthDayHourMinutePrecision 
        }, SUBSTR(str(?dtv), 1, 16), 1/0),
      IF(EXISTS{
          ?date vivo:dateTimePrecision vivo:yearMonthDayTimePrecision 
        }, SUBSTR(str(?dtv), 1, 19), 1/0)
    ) AS ?cleanDateValue
  )
  
}
ORDER BY ?date
""" ;
   :resultFormat "CSV" .
